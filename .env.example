# URL production, không có dấu / ở cuối.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Khóa trình duyệt Google Maps Platform (bật Maps JavaScript API; giới hạn theo tên miền). Để trống thì ẩn chế độ 3D Google và ảnh 360°.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Mã truy cập Cesium ion (gói Community miễn phí, không cần thẻ; giới hạn URL về tên miền của site).
# Dùng khi KHÔNG có khóa Google: nút "3D Google" khi đó mở thành phố 3D chân thực của Google qua Cesium ion.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
